# Same Postgres server as the other apps. Studio keeps its tables (and its own
# alembic_version) in POSTGRES_SCHEMA so it never touches the other apps' tables.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=karan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
POSTGRES_SCHEMA=studio
POSTGRES_ECHO=false

# production disables /docs and drops localhost CORS origins
ENVIRONMENT=development

# SSO (vendored karan_sso SDK). Locally the SSO backend runs on 8002.
SSO_BASE_URL=http://127.0.0.1:8002/api
SSO_ISSUER=http://localhost:8000/api/auth
SSO_AUDIENCE=karanparmar-apps
SSO_REQUIRE_AUDIENCE=true
SSO_APP_ID=studio
SSO_JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://100.90.184.17:5174,http://localhost:5174,https://studio.karanparmar.in

# How long one model call may take before the link is treated as down.
MODEL_TIMEOUT_SECONDS=180

# Shared secret sent as X-Flow-Token to the speech and LLM gateways.
# Must equal FLOW_TOKEN on every gateway you link (PC and VPS).
FLOW_TOKEN=

# Pre-filled model links for a new user (they can change them on the Model links page).
# Local = the studio-services gateways on Karan's PC reached through a tunnel.
# Remote = the gateway on the LLM VPS, called by IP: http://<llm-vps-ip>:8011.
SPEECH_LOCAL_URL=http://127.0.0.1:8003
LLM_LOCAL_URL=http://127.0.0.1:8003
LLM_REMOTE_URL=

# Garage object storage holds the desktop/Android app binaries (bucket studio-media).
# Leave blank in local dev; the download endpoints then return 503 but the app still runs.
GARAGE_ENDPOINT_URL=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_BUCKET_NAME=studio-media
GARAGE_REGION_NAME=garage

# Bearer token the release workflow (studio-frontend apps-release.yml) sends to upload
# new app binaries. Generate once: openssl rand -base64 24
STUDIO_RELEASE_TOKEN=
